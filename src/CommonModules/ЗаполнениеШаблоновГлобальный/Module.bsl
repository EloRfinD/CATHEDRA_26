
#Область ПрограммныйИнтерфейс

Функция ДокументНаОсновеШаблона(ШаблонСсылка, ПараметрыДокумента) Экспорт
	
	ПриложениеВорд = Неопределено;
	ОбъектШаблон = Неопределено;
	
	Попытка
		ПриложениеВорд = Новый COMОбъект("Word.Application");
		
	Исключение
		СообщениеПользователю = Новый СообщениеПользователю;
		СообщениеПользователю.Текст = "MS Word недоступен. Убедитесь, что Microsoft Word установлен на компьютере.";
		СообщениеПользователю.Сообщить();
		Возврат Неопределено;
	КонецПопытки;
	

	
	ДвоичныеДанные = ФункцииНаСервере.ПолучитьДвоичныеДанныеШаблонаНаСервере(ШаблонСсылка);
	ВременныйФайлШаблона = ПолучитьИмяВременногоФайла(".dotx");
	
	Попытка
		ДвоичныеДанные.Записать(ВременныйФайлШаблона);
		
	Исключение   
		СообщениеПользователю = Новый СообщениеПользователю;
		СообщениеПользователю.Текст = "Файл был поврежден или удален. Для продолжения работы загрузите заново.";
		СообщениеПользователю.Сообщить();
		Возврат Неопределено;		
	КонецПопытки;
	
	Попытка
		ОбъектШаблон = ПриложениеВорд.Documents.Add(ВременныйФайлШаблона);		
		ОбработатьПоляДокументаОптимально(ОбъектШаблон, ПараметрыДокумента);
		
		ФайлДляЗаписи = ПолучитьПутьКФайлуРезультата(ВременныйФайлШаблона, ПараметрыДокумента.ИмяФайла);

		ОбъектШаблон.SaveAs(ФайлДляЗаписи);

		Если ОбъектШаблон <> Неопределено Тогда
			ОбъектШаблон.Close(Ложь);
		КонецЕсли;

		НачатьУдалениеФайлов(ВременныйФайлШаблона);
		
		Если ПриложениеВорд <> Неопределено Тогда
			ПриложениеВорд.ScreenUpdating = Истина;
			ПриложениеВорд.DisplayAlerts = -1;
			ПриложениеВорд.Quit();
		КонецЕсли;
		
		Возврат ФайлДляЗаписи;
		
	Исключение
		СообщениеПользователю = Новый СообщениеПользователю;
		СообщениеПользователю.Текст = "Ошибка при формировании документа: " + ОписаниеОшибки();
		СообщениеПользователю.Сообщить();
				
		Если ОбъектШаблон <> Неопределено Тогда
			ОбъектШаблон.Close(Ложь);
		КонецЕсли;
		
		Если ПриложениеВорд <> Неопределено Тогда
			ПриложениеВорд.Quit();
		КонецЕсли;
		
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьЗначениеПараметраПоКлючу(ПараметрыДокумента, КлючПоля)
	
	Для Каждого Параметр Из ПараметрыДокумента Цикл
		
		Если КлючПоля = Параметр.Ключ Тогда 
			Возврат Параметр.Значение;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;

КонецФункции

Процедура НастроитьСтильТаблицыОптимально(ТаблицаWord)
	
	ТаблицаWord.Style = "Сетка таблицы";
	Границы = ТаблицаWord.Borders;
	Границы.OutsideLineStyle = 1;
	Границы.InsideLineStyle = 1;

КонецПроцедуры

Процедура УстановитьТекстЯчейкиОптимально(ТаблицаWord, Строка, Колонка, Текст)
	
	RangeЯчейки = ТаблицаWord.Cell(Строка, Колонка).Range;
	RangeЯчейки.Text = Текст;

КонецПроцедуры

Процедура УстановитьТекстЯчейкиСВыравниванием(ТаблицаWord, Строка, Колонка, Текст, Выравнивание = Неопределено,
	ВертикальноеВыравнивание = Неопределено, Жирный = Ложь)
	
	RangeЯчейки = ТаблицаWord.Cell(Строка, Колонка).Range;
	RangeЯчейки.Text = Текст;
	
	Если Выравнивание <> Неопределено Тогда
		RangeЯчейки.ParagraphFormat.Alignment = Выравнивание;
	КонецЕсли;
	
	Если ВертикальноеВыравнивание <> Неопределено Тогда
		RangeЯчейки.Cells(1).VerticalAlignment = ВертикальноеВыравнивание;
	КонецЕсли;
	
	Если Жирный Тогда
		RangeЯчейки.Font.Bold = Истина;
	КонецЕсли;

КонецПроцедуры

Процедура ОбработатьПоляДокументаОптимально(ОбъектШаблон, ПараметрыДокумента)
	
	ЗначенияПолей = Новый Соответствие;
	
	Для Каждого Поле Из ОбъектШаблон.Fields Цикл
		
		ПолноеИмяПоля = Поле.Code.Text;
		
		Если (СтрНайти(ПолноеИмяПоля, " MERGEFIELD") = 1) Тогда
			ПозицияСлеша = СтрНайти(ПолноеИмяПоля, "\*");
			РазмерТэга = 12;
			КороткоеИмяПоля = СокрЛП(Сред(ПолноеИмяПоля, РазмерТэга, ПозицияСлеша - РазмерТэга));
			ЗначениеПоля = ПолучитьЗначениеПараметраПоКлючу(ПараметрыДокумента, КороткоеИмяПоля);
			ЗначенияПолей.Вставить(Поле, Новый Структура("Имя,Значение", КороткоеИмяПоля, ЗначениеПоля));
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого КлючЗначение Из ЗначенияПолей Цикл
		Поле = КлючЗначение.Ключ;
		ДанныеПоля = КлючЗначение.Значение;
		ЗаполнитьПолеОптимально(ОбъектШаблон, Поле, ДанныеПоля.Имя, ДанныеПоля.Значение, ПараметрыДокумента);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьПолеОптимально(ОбъектШаблон, Поле, ИмяПоля, ЗначениеПоля, ПараметрыДокумента)
	
	ТипЗначенияПоля = ТипЗнч(ЗначениеПоля);

	ТалицаВШаблоне = ((ИмяПоля = "ФИО")
		И (ТипЗначенияПоля = Тип(Новый Массив)
		ИЛИ ТипЗначенияПоля = Тип(Новый Соответствие))
		И (ЗначениеПоля.Количество() >= 1));
	
	Если ТалицаВШаблоне Тогда
		Поле.Result.Text = " ";
		ОбработатьТаблицуПоТипуДокумента(ОбъектШаблон, Поле, ЗначениеПоля, ПараметрыДокумента.Тип);
	
	Иначе			
		
		Если ЗначениеПоля <> "" Тогда	
			Поле.Result.Text = ЗначениеПоля;
		КонецЕсли;		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьТаблицуПоТипуДокумента(ОбъектШаблон, Поле, ЗначениеПоля, ТипДокумента)
	
	Если ТипДокумента = ПредопределенноеЗначение("Перечисление.ТипыДокументов.ДелениеНаПодгруппы") Тогда	
		СоставитьТаблицуДелениеНаПодгруппы(ОбъектШаблон, Поле, ЗначениеПоля);
		
	ИначеЕсли ТипДокумента = ПредопределенноеЗначение("Перечисление.ТипыДокументов.ЗачислениеНаКурс") Тогда
		СоставитьТаблицуЗачисление(ОбъектШаблон, Поле, ЗначениеПоля);
		
	ИначеЕсли ТипДокумента = ПредопределенноеЗначение("Перечисление.ТипыДокументов.СЗСтимулирование") Тогда
		СоставитьТаблицуРасчетов(ОбъектШаблон, Поле, ЗначениеПоля);

	Иначе
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьПутьКФайлуРезультата(ПутьКШаблону, ИмяФайла)
	
	ПозСлеша = СтрНайти(ПутьКШаблону, "\", НаправлениеПоиска.СКонца);
	
	Возврат Лев(ПутьКШаблону, ПозСлеша) + ИмяФайла + ".docx";

КонецФункции

Процедура СоставитьТаблицуЗачисление(ОбъектШаблон, Поле, Значения)
	
	КоличествоСтрок = Значения.Количество() + 1;
	ТаблицаWord = ОбъектШаблон.Tables.Add(ОбъектШаблон.Bookmarks("ТаблицаСтудентов").Range, КоличествоСтрок, 3);

	НастроитьСтильТаблицыWordОптимально(ТаблицаWord);
	
	УстановитьТекстЯчейкиСВыравниванием(ТаблицаWord, 1, 1, "№ п/п", 1, , Истина);
	УстановитьТекстЯчейкиСВыравниванием(ТаблицаWord, 1, 2, "ФИО", 1, , Истина);
	УстановитьТекстЯчейкиСВыравниванием(ТаблицаWord, 1, 3, "Заказчик", 1, , Истина);
	
	Для Индекс = 0 По Значения.ВГраница() Цикл
		НомерСтроки = Индекс + 2;
		УстановитьТекстЯчейкиОптимально(ТаблицаWord, НомерСтроки, 1, Строка(Индекс + 1) + ".");
		УстановитьТекстЯчейкиОптимально(ТаблицаWord, НомерСтроки, 2, Значения[Индекс]);
		УстановитьТекстЯчейкиОптимально(ТаблицаWord, НомерСтроки, 3, "");
	КонецЦикла;                           
	
	НачальнаяЯчейка = ТаблицаWord.Cell(2, 3);
	КонечнаяЯчейка = ТаблицаWord.Cell(КоличествоСтрок, 3);
	НачальнаяЯчейка.Merge(КонечнаяЯчейка);
	
	RangeЗаказчик = ТаблицаWord.Cell(2, 3).Range;
	RangeЗаказчик.Text = "ФГАОУ ВО «Севастопольский государственный университет»";
	RangeЗаказчик.ParagraphFormat.Alignment = 0;
	RangeЗаказчик.Cells(1).VerticalAlignment = 0;
	
	ТаблицаWord.Columns(1).AutoFit();
	ТаблицаWord.Columns(2).Width = 280;
	ТаблицаWord.Columns(3).Width = 140;
	
КонецПроцедуры

Процедура СоставитьТаблицуДелениеНаПодгруппы(ОбъектШаблон, Поле, СписокСтудентов)
	
	Поле.Select();
	ОбъектШаблон.Application.Selection.TypeText(" ");
	
	ТаблицыПоГруппам = Новый Соответствие;
	ИмяЗакладки = "ТаблицаСтудентов";
	
	Для Каждого СтруктураПодгруппы Из СписокСтудентов Цикл	
		НомерПодгруппы = СтруктураПодгруппы.Номер;
		СтудентыГруппы = СтруктураПодгруппы.Студенты;
		
		Если ТаблицыПоГруппам.Получить(НомерПодгруппы) = Неопределено Тогда		
			ТаблицаWord = СоздатьТаблицуДляГруппы(ОбъектШаблон, ИмяЗакладки, НомерПодгруппы);
			ТаблицыПоГруппам.Вставить(НомерПодгруппы, ТаблицаWord);
			ОбъектШаблон.Bookmarks.Add(ИмяЗакладки, ТаблицаWord.Range);
		КонецЕсли; 
		
		Для Каждого Студент Из СтудентыГруппы Цикл
			ДобавитьСтудентаВТаблицу(ТаблицыПоГруппам[НомерПодгруппы], Студент);
		КонецЦикла;
	КонецЦикла;	
	
КонецПроцедуры

Функция СоздатьТаблицуДляГруппы(ОбъектШаблон, ИмяЗакладки, Номер)
	
	Range = ОбъектШаблон.Bookmarks(ИмяЗакладки).Range;
	Range.Collapse(0);
	Range.InsertParagraphAfter();
	Range.Collapse(0);
	
	Range.Text = "Группа " + Номер;
	Range.Font.Bold = Истина;
	Range.ParagraphFormat.Alignment = 1;
	Range.InsertParagraphAfter();
	Range.Collapse(0);
	Range.Font.Bold = Ложь;
	Range.ParagraphFormat.Alignment = 0;
	
	ТаблицаWord = ОбъектШаблон.Tables.Add(Range, 1, 2);
	
	НастроитьСтильТаблицыWordОптимально(ТаблицаWord);
	
	УстановитьТекстЯчейкиСВыравниванием(ТаблицаWord, 1, 1, "№", 1, , Истина);
	УстановитьТекстЯчейкиСВыравниванием(ТаблицаWord, 1, 2, "Фамилия Имя Отчество", 0, , Истина);
	
	ТаблицаWord.Columns(1).Width = 95;
	ТаблицаWord.Columns(2).Width = 371;
	
	Возврат ТаблицаWord;
	
КонецФункции

Процедура ДобавитьСтудентаВТаблицу(ТаблицаWord, ФИОСтудента)
	
	НоваяСтрока = ТаблицаWord.Rows.Add();
	НомерСтроки = Строка(ТаблицаWord.Rows.Count - 1) + ".";
	
	RangeЯчейки1 = НоваяСтрока.Cells(1).Range;
	RangeЯчейки1.Font.Bold = Ложь;
	RangeЯчейки1.ParagraphFormat.Alignment = 1;
	RangeЯчейки1.Text = НомерСтроки;
	
	RangeЯчейки2 = НоваяСтрока.Cells(2).Range;
	RangeЯчейки2.Font.Bold = Ложь;
	RangeЯчейки2.ParagraphFormat.Alignment = 0;
	RangeЯчейки2.Text = ФИОСтудента;
	
КонецПроцедуры

Процедура СоставитьТаблицуРасчетов(ОбъектШаблон, Поле, Значения)
	
	ТаблицаWord = ОбъектШаблон.Tables.Add(ОбъектШаблон.Bookmarks("ТаблицаРаботников").Range, Значения.Количество() + 1, 6);
	
	НастроитьСтильТаблицыWordОптимально(ТаблицаWord);
	
	УстановитьТекстЯчейкиСВыравниванием(ТаблицаWord, 1, 1, "№", 1, , Истина);
	УстановитьТекстЯчейкиСВыравниванием(ТаблицаWord, 1, 2, "Фамилия Имя Отчество", 1, , Истина);
	УстановитьТекстЯчейкиСВыравниванием(ТаблицаWord, 1, 3, "Должность", 1, , Истина);
	УстановитьТекстЯчейкиСВыравниванием(ТаблицаWord, 1, 4, "Группы", 1, , Истина);
	УстановитьТекстЯчейкиСВыравниванием(ТаблицаWord, 1, 5, "Количество часов", 1, , Истина);
	УстановитьТекстЯчейкиСВыравниванием(ТаблицаWord, 1, 6, "Сумма руб.", 1, , Истина);
	
	ТаблицаWord.Columns(1).Width = 25;
	ТаблицаWord.Columns(2).Width = 90;
	ТаблицаWord.Columns(3).Width = 110;
	ТаблицаWord.Columns(4).Width = 90;
	ТаблицаWord.Columns(5).Width = 75;
	ТаблицаWord.Columns(6).Width = 75;
	ТаблицаWord.Rows.Height = 70;
	ТаблицаWord.Rows(1).Height = 25;
	
	СтрокаWord = 2;
	РазделДобавлен = Ложь;
	НомерПоПорядку = 1;
	ИтоговаяСумма = 0;
	
	Для Индекс = 0 По Значения.ВГраница() Цикл		
		ДанныеСтроки = Значения[Индекс];
		
		Если НЕ РазделДобавлен И ДанныеСтроки[5] = Ложь Тогда	
			ТаблицаWord.Rows.Add();
			
			Ячейка1 = ТаблицаWord.Cell(СтрокаWord, 1);
			Ячейка6 = ТаблицаWord.Cell(СтрокаWord, 6);
			Ячейка1.Merge(Ячейка6);
			
			RangeРаздела = Ячейка1.Range;
			RangeРаздела.Text = "Техническое сопровождение";
			RangeРаздела.Font.Bold = Ложь;
			RangeРаздела.ParagraphFormat.Alignment = 0;
			
			ТаблицаWord.Rows(СтрокаWord).Height = 25;
			
			СтрокаWord = СтрокаWord + 1;
			НомерПоПорядку = 1;
			РазделДобавлен = Истина;	
		КонецЕсли;
		
		УстановитьТекстЯчейкиОптимально(ТаблицаWord, СтрокаWord, 1, Строка(НомерПоПорядку));
		УстановитьТекстЯчейкиОптимально(ТаблицаWord, СтрокаWord, 2, ДанныеСтроки[0]);
		УстановитьТекстЯчейкиОптимально(ТаблицаWord, СтрокаWord, 3, Строка(Формат(ДанныеСтроки[1], "ЧРГ=' '")));
		УстановитьТекстЯчейкиОптимально(ТаблицаWord, СтрокаWord, 4, ДанныеСтроки[2]);
		
		RangeЧасов = ТаблицаWord.Cell(СтрокаWord, 5).Range;
		RangeЧасов.Text = ДанныеСтроки[3];
		RangeЧасов.ParagraphFormat.Alignment = 1;
		
		RangeСуммы = ТаблицаWord.Cell(СтрокаWord, 6).Range;
		RangeСуммы.Text = ДанныеСтроки[4];
		RangeСуммы.ParagraphFormat.Alignment = 2;
		
		ИтоговаяСумма = ИтоговаяСумма + ДанныеСтроки[4];
		СтрокаWord = СтрокаWord + 1;
		НомерПоПорядку = НомерПоПорядку + 1;	
	КонецЦикла;
	
	ДобавитьИтоговуюСтроку(ТаблицаWord, СтрокаWord, ИтоговаяСумма);
	
КонецПроцедуры

Процедура ДобавитьИтоговуюСтроку(ТаблицаWord, НомерСтроки, Сумма)
	
	ТаблицаWord.Rows.Add();
	
	Ячейка1 = ТаблицаWord.Cell(НомерСтроки, 1);
	Ячейка5 = ТаблицаWord.Cell(НомерСтроки, 5);
	Ячейка1.Merge(Ячейка5);
	
	RangeИтого = Ячейка1.Range;
	RangeИтого.Text = "Итого";
	RangeИтого.Font.Bold = Истина;
	RangeИтого.ParagraphFormat.Alignment = 2;
	
	RangeСумма = ТаблицаWord.Cell(НомерСтроки, 2).Range;
	RangeСумма.Text = Строка(Сумма);
	RangeСумма.Font.Bold = Истина;
	RangeСумма.ParagraphFormat.Alignment = 2;
	
	ТаблицаWord.Rows(НомерСтроки).Height = 15;
	
КонецПроцедуры

#КонецОбласти
