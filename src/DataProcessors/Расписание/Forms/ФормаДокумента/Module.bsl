
&НаКлиенте
Процедура Обновить(Команда)
	ОбновитьДанные();
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	ЗагрузитьРасписаниеНаСервере(Программа, Преподаватель, Число(Месяц(ДатаОтображения)));
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьРасписаниеНаСервере(ПрограммаСсылка, ПреподавательФильтр, Месяц)
	
	Если ПрограммаСсылка.Преподаватели.Количество() = 0 Тогда
		СообщениеПользователю = Новый СообщениеПользователю;
		СообщениеПользователю.Текст = "В программе нет преподавателей!";
		СообщениеПользователю.Сообщить();
		Возврат;
	КонецЕсли;
	
	Недели = ПолучитьНомераНедель(Месяц);
	
	Для Каждого СтрокаПреподаватель Из ПрограммаСсылка.Преподаватели Цикл
		
		ТекущийПреподаватель = СтрокаПреподаватель.Преподаватель;
		
		Если ПреподавательФильтр <> Справочники.Сотрудники.ПустаяСсылка() И ТекущийПреподаватель <> ПреподавательФильтр Тогда
			Продолжить;
		КонецЕсли;
		
		ФИОТранслитом = ПреобразованиеФИОТранслитом(ТекущийПреподаватель.Наименование);
		
		//@skip-check query-in-loop
		УдалитьСуществующиеЗадачи(ТекущийПреподаватель, Недели[0], Недели[Недели.Количество() - 1], Месяц);
		
		Для Каждого НомерНедели Из Недели Цикл
			Результат = ПолучитьJSONПоСсылке(ФИОТранслитом, НомерНедели);
			
			СоздатьЗадачиПоРасписанию(Результат, НомерНедели, ТекущийПреподаватель, Месяц, ПрограммаСсылка);
		КонецЦикла;
	КонецЦикла;
	
	ОбновитьДанныеПланировщикаСервер();
КонецПроцедуры

&НаСервере
Процедура УдалитьСуществующиеЗадачи(ПреподавательСсылка, НомерНеделиНачало, НомерНеделиКонец, Месяц)
	ТекущийГод = Год(ТекущаяДатаСеанса());
	
	ДатаНачалаМесяца = Дата(ТекущийГод, Месяц, 1);
	ДатаОкончанияМесяца = КонецМесяца(ДатаНачалаМесяца);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗадачаСотрудника.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗадачаСотрудника КАК ЗадачаСотрудника
		|ГДЕ
		|	ЗадачаСотрудника.Преподаватель = &Преподаватель
		|	И ЗадачаСотрудника.Основная = ИСТИНА
		|	И ЗадачаСотрудника.ДатаНачала >= &ДатаНачала
		|	И ЗадачаСотрудника.ДатаОкончания <= &ДатаОкончания";
	
	Запрос.УстановитьПараметр("Преподаватель", ПреподавательСсылка);
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачалаМесяца);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончанияМесяца);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ОбъектЗадачи = Выборка.Ссылка.ПолучитьОбъект();
		ОбъектЗадачи.УстановитьПометкуУдаления(Истина);
		ОбъектЗадачи.Записать();
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ПолучитьНомераНедель(Месяц)
	
	ТекущийГод = Год(ТекущаяДатаСеанса());
	ПредыдущийГод = ТекущийГод - 1;
	
	СентябрьНомер = 9;
	ДатаНачалаУчебногоГода = Дата(ПредыдущийГод, СентябрьНомер, 1);
	ДатаНачалаМесяца = Дата(ТекущийГод, Месяц, 1);
	ДатаОкончанияМесяца = КонецМесяца(ДатаНачалаМесяца);
	СчетДаты = ДатаНачалаУчебногоГода;
	СчетчикНедель = 1;
	
	ДнейВНеделе = 7;
	Сутки = 24;
	МинутыСекунды = 60;
	Неделя = ДнейВНеделе * Сутки * МинутыСекунды * МинутыСекунды;
	
	Пока ДатаНачалаМесяца >= СчетДаты + Неделя Цикл
		СчетДаты = СчетДаты + Неделя;
		СчетчикНедель = СчетчикНедель + 1;
	КонецЦикла;
	
	МассивНедель = Новый Массив;
	МассивНедель.Добавить(СчетчикНедель);
	
	Пока ДатаОкончанияМесяца >= СчетДаты + Неделя Цикл
		СчетДаты = СчетДаты + Неделя;
		СчетчикНедель = СчетчикНедель + 1;
		МассивНедель.Добавить(СчетчикНедель);
	КонецЦикла;
	
	Возврат МассивНедель;
	
КонецФункции

&НаСервере
Функция ПреобразованиеФИОТранслитом(Знач ФИО)
	
	ФИО = НРег(ФИО);
	ФИО = СтрЗаменить(ФИО, "ё", "е");
	ФИО = СтрЗаменить(ФИО, " ", "-");
	
	ТаблицаТранслита = Новый Соответствие;
	ТаблицаТранслита.Вставить("а", "a");
	ТаблицаТранслита.Вставить("б", "b");
	ТаблицаТранслита.Вставить("в", "v");
	ТаблицаТранслита.Вставить("г", "g");
	ТаблицаТранслита.Вставить("д", "d");
	ТаблицаТранслита.Вставить("е", "e");
	ТаблицаТранслита.Вставить("ж", "zh");
	ТаблицаТранслита.Вставить("з", "z");
	ТаблицаТранслита.Вставить("и", "i");
	ТаблицаТранслита.Вставить("й", "j");
	ТаблицаТранслита.Вставить("к", "k");
	ТаблицаТранслита.Вставить("л", "l");
	ТаблицаТранслита.Вставить("м", "m");
	ТаблицаТранслита.Вставить("н", "n");
	ТаблицаТранслита.Вставить("о", "o");
	ТаблицаТранслита.Вставить("п", "p");
	ТаблицаТранслита.Вставить("р", "r");
	ТаблицаТранслита.Вставить("с", "s");
	ТаблицаТранслита.Вставить("т", "t");
	ТаблицаТранслита.Вставить("у", "u");
	ТаблицаТранслита.Вставить("ф", "f");
	ТаблицаТранслита.Вставить("х", "h");
	ТаблицаТранслита.Вставить("ц", "c");
	ТаблицаТранслита.Вставить("ч", "ch");
	ТаблицаТранслита.Вставить("ш", "sh");
	ТаблицаТранслита.Вставить("щ", "sh");
	ТаблицаТранслита.Вставить("ъ", "u");
	ТаблицаТранслита.Вставить("ы", "y");
	ТаблицаТранслита.Вставить("ь", "");
	ТаблицаТранслита.Вставить("э", "e");
	ТаблицаТранслита.Вставить("ю", "yu");
	ТаблицаТранслита.Вставить("я", "ya");
	
	Результат = "";
	Для Инд = 1 По СтрДлина(ФИО) Цикл
		Символ = Сред(ФИО, Инд, 1);
		
		Если ТаблицаТранслита.Получить(Символ) <> Неопределено Тогда
			Результат = Результат + ТаблицаТранслита.Получить(Символ);
		Иначе
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьJSONПоСсылке(ФИОТранслитом, НомерНедели)
	
	Успех = Новый Структура("КодУспеха", 200);
	Таймаут = 30;
	
	ПараметрыЗапроса = "v=6.1&teacher=" + ФИОТранслитом + "&week=" + Формат(НомерНедели, "ЧГ=0");
	
	HTTPСоединение = Новый HTTPСоединение(
		"schedule.sevsu.ru", 
		, 
		, 
		, 
		, 
		Таймаут, 
		Новый ЗащищенноеСоединениеOpenSSL());
		
	HTTPЗапрос = Новый HTTPЗапрос("/api/teacher-schedule?" + ПараметрыЗапроса);
	
	Ответ = HTTPСоединение.Получить(HTTPЗапрос);
	
	Если Ответ.КодСостояния <> Успех.КодУспеха Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
	Результат = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура СоздатьЗадачиПоРасписанию(РезультатJSON, НомерНедели, ПреподавательСсылка, Месяц, ПрограммаСсылка)
	
	Если РезультатJSON = Неопределено Или НЕ РезультатJSON.ok Тогда
		Возврат;
	КонецЕсли;
	
	Расписание = РезультатJSON.schedule;
	
	ТекущийГод = Год(ТекущаяДатаСеанса());
	ДатаНачалаМесяца = Дата(ТекущийГод, Месяц, 1);
	
	Для Каждого Занятие Из Расписание Цикл				
		ДатаЗанятия = Дата(СтрЗаменить(Занятие.date, "-", ""));
		
		Если ДатаЗанятия <= ДатаНачалаМесяца Тогда
			Продолжить;
		КонецЕсли;
		
		НовыйДокумент = Документы.ЗадачаСотрудника.СоздатьДокумент();
		НовыйДокумент.Преподаватель = ПреподавательСсылка;
		НовыйДокумент.Дата = ТекущаяДатаСеанса();
		НомерЗанятия = Занятие.n;
		
		Отбор = Новый Структура("НомерПары", НомерЗанятия);
		ВремяНачала = РегистрыСведений.НомераПарВремяСоответсвие.Получить(Отбор).ВремяНачала;
		ВремяОкончания = РегистрыСведений.НомераПарВремяСоответсвие.Получить(Отбор).ВремяОкончания;
		
		НовыйДокумент.ДатаНачала = НачалоДня(ДатаЗанятия) + (ВремяНачала - НачалоДня(ВремяНачала));
		НовыйДокумент.ДатаОкончания = НачалоДня(ДатаЗанятия) + (ВремяОкончания - НачалоДня(ВремяОкончания));
		НовыйДокумент.Предмет = Занятие.lesson;
		НовыйДокумент.Аудитория = Занятие.location;
		НовыйДокумент.Программа = ПрограммаСсылка;
		НовыйДокумент.Основная = Истина;
		НовыйДокумент.Записать();
	КонецЦикла;
	
КонецПроцедуры

