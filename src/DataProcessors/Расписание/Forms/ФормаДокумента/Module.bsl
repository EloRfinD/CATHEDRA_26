&НаСервере
Процедура ОбновитьДанныеПланировщикаСервер()
	
	Планировщик.Элементы.Очистить();
	Планировщик.ИнтервалыФона.Очистить();
	
	УстановитьОтображениеПланировщика();
	
	ПериодДанных = ПолучитьПериодДанных(ВариантПериода, ДатаОтображения);
	
	Планировщик.ТекущиеПериодыОтображения.Очистить();
	Планировщик.ТекущиеПериодыОтображения.Добавить(ПериодДанных.ДатаНачала, ПериодДанных.ДатаОкончания);
	
	ЗаполнитьДанныеСервер(ПериодДанных);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтображениеПланировщика()
	
	Если ВариантПериода = "День" Тогда
		
		Планировщик.ОтображатьТекущуюДату = НастройкиОтображения.ОтображатьТекущуюДату;
		Планировщик.ЕдиницаПериодическогоВарианта = ТипЕдиницыШкалыВремени.Час;
		Планировщик.КратностьПериодическогоВарианта = 24;
		Планировщик.ОтступСНачалаПереносаШкалыВремени = НастройкиОтображения.НачалоРабочегоДня;
		Планировщик.ОтступСКонцаПереносаШкалыВремени = ?(НастройкиОтображения.ОкончаниеРабочегоДня = 0,
		0, 24 - НастройкиОтображения.ОкончаниеРабочегоДня);
		Планировщик.ОтображатьПеренесенныеЗаголовкиШкалыВремени = Ложь;
		Планировщик.ОтображениеВремениЭлементов = ОтображениеВремениЭлементовПланировщика.ВремяНачалаИКонца;
		Планировщик.ФорматПеренесенныхЗаголовковШкалыВремени = "ДФ='dddd, d MMMM yyyy'";
		Планировщик.ШкалаВремени.Положение = ПоложениеШкалыВремени.Лево;
		Планировщик.ШкалаВремени.Элементы[0].Формат = "ДФ=ЧЧ:мм";
		Планировщик.ШкалаВремени.Элементы[0].Кратность = 1;
		Планировщик.ШкалаВремени.Элементы[0].Единица = ТипЕдиницыШкалыВремени.Час;
		
	ИначеЕсли ВариантПериода = "Неделя" Тогда
		
		Планировщик.ОтображатьТекущуюДату = НастройкиОтображения.ОтображатьТекущуюДату;
		Планировщик.ЕдиницаПериодическогоВарианта = ТипЕдиницыШкалыВремени.Час;
		Планировщик.КратностьПериодическогоВарианта = 24;
		Планировщик.ОтступСНачалаПереносаШкалыВремени = НастройкиОтображения.НачалоРабочегоДня;
		Планировщик.ОтступСКонцаПереносаШкалыВремени = ?(НастройкиОтображения.ОкончаниеРабочегоДня = 0,
		0, 24 - НастройкиОтображения.ОкончаниеРабочегоДня);
		Планировщик.ОтображатьПеренесенныеЗаголовки = Истина;
		Планировщик.ОтображатьПеренесенныеЗаголовкиШкалыВремени = Ложь;
		Планировщик.ОтображениеВремениЭлементов = ОтображениеВремениЭлементовПланировщика.НеОтображать;
		Планировщик.ФорматПеренесенныхЗаголовковШкалыВремени = "ДФ='ddd, d MMMM'";
		Планировщик.ШкалаВремени.Положение = ПоложениеШкалыВремени.Лево;
		Планировщик.ШкалаВремени.Элементы[0].Формат = "ДФ=ЧЧ:мм";
		Планировщик.ШкалаВремени.Элементы[0].Кратность = 1;
		Планировщик.ШкалаВремени.Элементы[0].Единица = ТипЕдиницыШкалыВремени.Час;
		
	ИначеЕсли ВариантПериода = "Месяц" Тогда
		
		Планировщик.ОтображатьТекущуюДату = Ложь;
		Планировщик.ЕдиницаПериодическогоВарианта = ТипЕдиницыШкалыВремени.День;
		Планировщик.КратностьПериодическогоВарианта = 7;
		Планировщик.ОтступСНачалаПереносаШкалыВремени = 0;
		Планировщик.ОтступСКонцаПереносаШкалыВремени = 0;
		Планировщик.ОтображатьПеренесенныеЗаголовки = Ложь;
		Планировщик.ОтображатьПеренесенныеЗаголовкиШкалыВремени = Истина;
		Планировщик.ОтображениеВремениЭлементов = ОтображениеВремениЭлементовПланировщика.НеОтображать;
		Планировщик.ФорматПеренесенныхЗаголовковШкалыВремени = "ДФ='ddd, d MMM yyyy'";
		Планировщик.ШкалаВремени.Положение = ПоложениеШкалыВремени.Верх;
		Планировщик.ШкалаВремени.Элементы[0].Формат = "ДФ='ddd, d MMM yyyy'";
		Планировщик.ШкалаВремени.Элементы[0].Кратность = 1;
		Планировщик.ШкалаВремени.Элементы[0].Единица = ТипЕдиницыШкалыВремени.День;
		
		Интервал = Планировщик.ИнтервалыФона.Добавить(НачалоМесяца(ДатаОтображения), КонецМесяца(ДатаОтображения)); 
		СтруктураЦветов = ПолучитьСтруктуруЦветов();
		Интервал.Цвет = СтруктураЦветов.Серый;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьЭлементыПланировщикаСервер()
	
	Планировщик.Элементы.Очистить();
	
	ПериодДанных = ПолучитьПериодДанных(ВариантПериода, ДатаОтображения);
	
	ЗаполнитьДанныеСервер(ПериодДанных);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеСервер(Знач ПериодДанных)
	
	СписокПреподавателей = Новый СписокЗначений;
	
	Если Преподаватель = Справочники.Сотрудники.ПустаяСсылка() Тогда
		Если Программа <> Справочники.УчебныеПрограммы.ПустаяСсылка() Тогда
			Для Каждого СтрокаПреподаватель Из Программа.Преподаватели Цикл
				СписокПреподавателей.Добавить(СтрокаПреподаватель.Преподаватель);
			КонецЦикла;
			СтрокаФильтр = " И ЗадачаСотрудника.Основная = ЛОЖЬ";
		Иначе
			Возврат;
		КонецЕсли;
	Иначе
		СписокПреподавателей.Добавить(Преподаватель);
	КонецЕсли;
	
	Если СписокПреподавателей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос();
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗадачаСотрудника.Ссылка КАК Ссылка,
		|	ЗадачаСотрудника.ДатаНачала КАК ДатаНачала,
		|	ЗадачаСотрудника.ДатаОкончания КАК ДатаОкончания,
		|	ЗадачаСотрудника.Предмет КАК Предмет,
		|	ЗадачаСотрудника.Тема КАК Тема,
		|	ЗадачаСотрудника.Аудитория КАК Аудитория,
		|	ЗадачаСотрудника.Основная КАК Основная,
		|	ЗадачаСотрудника.Дистанционное КАК Дистанционное,
		|	УчебныеПрограммы.НаименованиеПрограммыСокращенно КАК Программа,
		|	Сотрудники.Наименование КАК Преподаватель,
		|	ЗадачаСотрудника.ТипЗанятия КАК ТипЗанятия
		|ИЗ
		|	Документ.ЗадачаСотрудника КАК ЗадачаСотрудника
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УчебныеПрограммы КАК УчебныеПрограммы
		|		ПО ЗадачаСотрудника.Программа = УчебныеПрограммы.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК Сотрудники
		|		ПО ЗадачаСотрудника.Преподаватель = Сотрудники.Ссылка
		|ГДЕ
		|	ЗадачаСотрудника.ДатаНачала <= &ДатаОкончания
		|	И ЗадачаСотрудника.ДатаОкончания >= &ДатаНачала
		|	И ЗадачаСотрудника.Программа = &Программа
		|	И ЗадачаСотрудника.Преподаватель В (&Преподаватели)
		|	И ЗадачаСотрудника.ПометкаУдаления = ЛОЖЬ" + СтрокаФильтр;
	
	Запрос.УстановитьПараметр("ДатаНачала", ПериодДанных.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ПериодДанных.ДатаОкончания);
	Запрос.УстановитьПараметр("Программа", Программа);
	Запрос.УстановитьПараметр("Преподаватели", СписокПреподавателей);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ЭлементПланировщика = Планировщик.Элементы.Добавить(Выборка.ДатаНачала, Выборка.ДатаОкончания);
		ЭлементПланировщика.Значение = Новый Структура;
		
		Если Выборка.Основная Тогда
			СтруктураЦветов = ПолучитьСтруктуруЦветов();
			ЭлементПланировщика.ЦветФона = СтруктураЦветов.Красный;
			ЭлементПланировщика.Значение.Вставить("РедактированиеЗапрещено", Выборка.Основная);
			ЭлементПланировщика.Значение.Вставить("Ссылка", Выборка.Ссылка);
			ПредставлениеЗадачи = Выборка.Предмет + " " + Выборка.ТипЗанятия + " " + Выборка.Аудитория;
			ЭлементПланировщика.Текст = ПредставлениеЗадачи;
			
		Иначе	
			СтруктураЦветов = ПолучитьСтруктуруЦветов();
			ЭлементПланировщика.ЦветФона = СтруктураЦветов.Синий;
			ЭлементПланировщика.Значение.Вставить("РедактированиеЗапрещено", Не Выборка.Основная);
			ЭлементПланировщика.Значение.Вставить("Ссылка", Выборка.Ссылка);
			ПредставлениеЗадачи = Выборка.Тема + " " + Выборка.ТипЗанятия + " " + Выборка.Преподаватель + " " + Выборка.Аудитория;
			ЭлементПланировщика.Текст = ПредставлениеЗадачи;
		КонецЕсли;	
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ДатаОтображения = ТекущаяДатаСеанса();
	НастройкиОтображения = Новый Структура();
	НастройкиОтображения.Вставить("НачалоРабочегоДня", 8);
	НастройкиОтображения.Вставить("ОкончаниеРабочегоДня", 23);
	НастройкиОтображения.Вставить("ОтображатьТекущуюДату", Истина);
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ВариантПериода = "Месяц";
	ВыделитьПериодОтображения(ЭтотОбъект);
	ОбновитьДанные();
КонецПроцедуры

&НаКлиенте
Процедура ПланировщикПриАктивизации(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Элементы.Планировщик.ВыделенныеЭлементы.Количество() > 0 Тогда
		ЗначениеЭлемента = Элементы.Планировщик.ВыделенныеЭлементы[0].Значение;
		
		Если ЗначениеЭлемента.Ссылка <> Неопределено Тогда
			ОткрытьФормуЗадачи(ЗначениеЭлемента.Ссылка);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуЗадачи(ЗадачаСсылка)
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Ключ", ЗадачаСсылка);
	
	Если Проверка(ЗадачаСсылка) Тогда
		ПараметрыФормы.Вставить("ТолькоПросмотр", Истина);
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ОбработкаЗакрытияФормыЗадачи", ЭтотОбъект);
	ОткрытьФорму("Документ.ЗадачаСотрудника.Форма.ФормаДокумента", 
		ПараметрыФормы, 
		ЭтотОбъект,	, , , 
		Оповещение,
		РежимБлокировкиПриОткрытииОкнаФормы.БлокироватьВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаЗакрытияФормыЗадачи(Результат, ДополнительныеПараметры) Экспорт
	Если Результат <> Неопределено Тогда
		ОбновитьДанные();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПланировщикПриСменеТекущегоПериодаОтображения(Элемент, ТекущиеПериодыОтображения, СтандартнаяОбработка)
	
	Если ВариантПериода = "Месяц" Тогда
		
		СтандартнаяОбработка = Ложь;
		ТекущаяДатаСеанса = ТекущаяДата();
		
		Если ТекущиеПериодыОтображения[0].Начало = НачалоДня(ТекущаяДатаСеанса) Тогда
			ДатаОтображения = ТекущаяДатаСеанса;
		
		ИначеЕсли ТекущиеПериодыОтображения[0].Начало < Планировщик.ТекущиеПериодыОтображения[0].Начало Тогда
			ДатаОтображения = ДобавитьМесяц(ДатаОтображения, -1);
		
		ИначеЕсли ТекущиеПериодыОтображения[0].Начало > Планировщик.ТекущиеПериодыОтображения[0].Начало Тогда
			ДатаОтображения = ДобавитьМесяц(ДатаОтображения, 1);
		КонецЕсли;
		
		ПериодДанных = ПолучитьПериодДанных(ВариантПериода, ДатаОтображения);
		Планировщик.ТекущиеПериодыОтображения.Очистить();
		Планировщик.ТекущиеПериодыОтображения.Добавить(ПериодДанных.ДатаНачала, ПериодДанных.ДатаОкончания);
		
		Планировщик.ИнтервалыФона.Очистить();
		Интервал = Планировщик.ИнтервалыФона.Добавить(НачалоМесяца(ДатаОтображения), КонецМесяца(ДатаОтображения));
		
		СтруктураЦветов = ПолучитьСтруктуруЦветов();
		Интервал.Цвет = СтруктураЦветов.Серый;
		
		Если НастройкиОтображения.ОтображатьТекущуюДату Тогда
			Интервал = Планировщик.ИнтервалыФона.Добавить(НачалоДня(ТекущаяДатаСеанса), КонецДня(ТекущаяДатаСеанса));
			Интервал.Цвет = СтруктураЦветов.Синий;
		КонецЕсли;
		
	Иначе
		
		ДатаОтображения = ТекущиеПериодыОтображения[0].Начало;
		ОбновитьЭлементыПланировщика();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСтруктуруЦветов()
	СтруктураЦветов = Новый Структура();
	СтруктураЦветов.Вставить("Серый", ЦветаПалитры.Серый);
	СтруктураЦветов.Вставить("Синий", ЦветаПалитры.Синий);
	СтруктураЦветов.Вставить("Красный", ЦветаПалитры.Красный);
	Возврат СтруктураЦветов;
КонецФункции

&НаСервере
Функция Проверка(Ссылка)
	Возврат Ссылка.Основная;
КонецФункции
