#Область ОбработчикиСобытий

&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)

	ТипДокумента1 = ПолучитьТипДокументаСЗСтимулированиеНаСервере();
	ТипДокумента2 = ПолучитьТипДокументаРасчетныйЛистПреподавательНаСервере();
	ТипДокумента3 = ПолучитьТипДокументаРасчетныйЛистРуководительНаСервере();
	ТипДокумента4 = ПолучитьТипДокументаРасчетныйЛистТехникНаСервере();

	Оповещение = Новый ОписаниеОповещения(
		"ВыборШаблонаЗавершен",
		ЭтотОбъект,
		Новый Структура("ПараметрКоманды", ПараметрКоманды));

	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("РежимВыбора", Истина);
	ПараметрыОткрытия.Вставить("МножественныйВыбор", Истина);
	ПараметрыОткрытия.Вставить("ЗакрыватьПриВыборе", Истина);
	ПараметрыОткрытия.Вставить("ТипДокумента1", ТипДокумента1);
	ПараметрыОткрытия.Вставить("ТипДокумента2", ТипДокумента2);
	ПараметрыОткрытия.Вставить("ТипДокумента3", ТипДокумента3);
	ПараметрыОткрытия.Вставить("ТипДокумента4", ТипДокумента4);

	ОткрытьФорму("Справочник.ШаблоныДокументов.ФормаВыбора", ПараметрыОткрытия, , , , , Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ВыборШаблонаЗавершен(РезультатВыбора, ДополнительныеПараметры) Экспорт

	Если РезультатВыбора <> Неопределено Тогда
		ПараметрыДокумента = ПолучитьПараметрыНаСервере(ДополнительныеПараметры.ПараметрКоманды[0]);
			
		Для каждого СсылкаНаШаблон Из РезультатВыбора Цикл
			
			Если Не СсылкаНаШаблон.Пустая() Тогда
				ТипДокумента = ПолучитьРеквизитПоСсылке(СсылкаНаШаблон);
				
				Если ТипДокумента = ПолучитьТипДокументаСЗСтимулированиеНаСервере() Тогда
					ПараметрыДокумента = ПолучитьПараметрыНаСервере(ДополнительныеПараметры.ПараметрКоманды[0]);
					ДокументНаОсновеШаблона(СсылкаНаШаблон, ПараметрыДокумента);
					
				ИначеЕсли ТипДокумента = ПолучитьТипДокументаРасчетныйЛистПреподавательНаСервере() Тогда
					ПараметрыДокумента = ПолучитьПараметрыПреподавательНаСервере(ДополнительныеПараметры.ПараметрКоманды[0]);
					
					Для каждого Параметр Из ПараметрыДокумента Цикл	
						ДокументНаОсновеШаблона(СсылкаНаШаблон, Параметр.Значение);
					КонецЦикла;
					
				ИначеЕсли ТипДокумента = ПолучитьТипДокументаРасчетныйЛистТехникНаСервере() Тогда
					ПараметрыДокумента = ПолучитьПараметрыТехникНаСервере(ДополнительныеПараметры.ПараметрКоманды[0]);
					
					Для каждого Параметр Из ПараметрыДокумента Цикл	
						ДокументНаОсновеШаблона(СсылкаНаШаблон, Параметр.Значение);
					КонецЦикла;
					
				ИначеЕсли ТипДокумента = ПолучитьТипДокументаРасчетныйЛистРуководительНаСервере() Тогда
					ПараметрыДокумента = ПолучитьПараметрыРуководительНаСервере(ДополнительныеПараметры.ПараметрКоманды[0]);
					ДокументНаОсновеШаблона(СсылкаНаШаблон, ПараметрыДокумента);
				КонецЕсли;		
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

