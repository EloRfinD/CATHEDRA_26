
#Область ОбработчикиСобытийЭлементовТаблицыФормы

&НаКлиенте
Процедура ПрограммаПриИзменении(Элемент)

	ДанныеДляЗаполнения = ПолучитьДанныеРуководителяНаСервере(Объект.Программа);

	Объект.Руководитель = ДанныеДляЗаполнения.Руководитель;
	Объект.ДолжностьРуководителя = ДанныеДляЗаполнения.Должность;
	Объект.СтепеньРуководителя = ДанныеДляЗаполнения.Степень;
	Объект.КафедраРуководителя = ДанныеДляЗаполнения.Кафедра;
	Объект.РазмерОкладаРуководителя = ДанныеДляЗаполнения.РазмерОклада;
	Объект.ОбъемПрограммы = ДанныеДляЗаполнения.КоличествоУчебныхЧасов;
	Объект.КоличествоСтудентов = ДанныеДляЗаполнения.КоличествоСлушателей;

	НормаЧасовРуководителя = ПолучитьНормуЧасовНаСервере(ДанныеДляЗаполнения.Должность);
	КоэффициентРасчета = 10;
	ПроцентОплаты = 100;
	ПроцентПремии = 0.2;
	МаксимальнаяВыплатаРуководителю = 30000;

	Объект.НормаЧасовРуководителя = НормаЧасовРуководителя;
	Объект.ТарифРуководителя = (ДанныеДляЗаполнения.РазмерОклада / НормаЧасовРуководителя) * КоэффициентРасчета;
	КВыплате = (Объект.ТарифРуководителя * Объект.КоличествоСтудентов * Объект.ОбъемПрограммы)
		/ ПроцентОплаты * ПроцентПремии;
	Объект.КВыплатеРуководителю = ?(КВыплате > МаксимальнаяВыплатаРуководителю, МаксимальнаяВыплатаРуководителю, КВыплате);

КонецПроцедуры

&НаКлиенте
Процедура РасчетПоТехническомуСопровождениюФИОПриИзменении(Элемент)

	ТекущаяСтрока = Элементы.РасчетПоТехническомуСопровождению.ТекущиеДанные;

	ДанныеДляЗаполнения = ПолучитьДанныеНаСервере(ТекущаяСтрока.ФИО);

	ТекущаяСтрока.Должность = ДанныеДляЗаполнения.Должность;
	ТекущаяСтрока.Кафедра_Отдел = ДанныеДляЗаполнения.Кафедра;
	ТекущаяСтрока.РазмерОклада = ДанныеДляЗаполнения.РазмерОклада;
	ТекущаяСтрока.К4 = ДанныеДляЗаполнения.К4;

	ТекущаяСтрока.НормаЧасов = ПолучитьНормуЧасовНаСервере(ДанныеДляЗаполнения.Должность);

	РассчитатьКВыплатеТехПоддержка(ТекущаяСтрока);

КонецПроцедуры

