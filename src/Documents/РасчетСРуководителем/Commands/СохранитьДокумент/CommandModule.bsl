#Область ОбработчикиСобытий

&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)

	ТипДокумента = ПолучитьТипДокументаНаСервере();

	Оповещение = Новый ОписаниеОповещения(
		"ВыборШаблонаЗавершен",
		ЭтотОбъект,
		Новый Структура("ПараметрКоманды", ПараметрКоманды));

	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("РежимВыбора", Истина);
	ПараметрыОткрытия.Вставить("МножественныйВыбор", Ложь);
	ПараметрыОткрытия.Вставить("ЗакрыватьПриВыборе", Истина);
	ПараметрыОткрытия.Вставить("ТипДокумента", ТипДокумента);	

	ОткрытьФорму("Справочник.ШаблоныДокументов.ФормаВыбора", ПараметрыОткрытия, , , , , Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ВыборШаблонаЗавершен(РезультатВыбора, ДополнительныеПараметры) Экспорт

	Если РезультатВыбора <> Неопределено Тогда
		СсылкаНаШаблон = РезультатВыбора;
		
		Если Не СсылкаНаШаблон.Пустая() Тогда
			ПараметрыДокумента = ПолучитьПараметрыНаСервере(ДополнительныеПараметры.ПараметрКоманды[0]);
			ФайлWord = ДокументНаОсновеШаблона(СсылкаНаШаблон, ПараметрыДокумента);
			
			Если ФайлWord <> Неопределено Тогда
				ЗапуститьПриложение(ФайлWord);
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПолучитьТипДокументаНаСервере()

	Возврат Перечисления.ТипыДокументов.СЗСтимулированиеРуководитель;

КонецФункции

&НаСервере
Функция ПолучитьПараметрыНаСервере(Знач Ссылка)

	Перем ГодВыплаты;
	
	ПараметрыДокумента = Новый Структура();

	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
		
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УтвержденПриказом.Значение КАК Приказ,
	|	ШифрПроекта.Значение КАК ШифрПроекта,
	|	УчебныеПрограммы.НаименованиеПрограммы КАК НаименованиеПрограммы,
	|	РасчетСРуководителем.ДатаВыплаты КАК ДатаВыплаты,
	|	УчебныеПрограммы.НаименованиеПрограммыСокращенно КАК НаименованиеПрограммыСокращенно,
	|	СТРОКА(УчебныеПрограммы.Код) КАК Код
	|ИЗ
	|	Константа.ШифрПроекта КАК ШифрПроекта,
	|	Константа.УтвержденПриказом КАК УтвержденПриказом,
	|	Документ.РасчетСРуководителем КАК РасчетСРуководителем
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УчебныеПрограммы КАК УчебныеПрограммы
	|		ПО РасчетСРуководителем.Программа = УчебныеПрограммы.Ссылка";   

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл		
		ГодВыплаты = Строка(Формат(Выборка.ДатаВыплаты, "ДФ=гггг"));
		МесяцВыплаты = НРег(Формат(Выборка.ДатаВыплаты, "ДФ=ММММ"));
		МесяцВыплатыПредложныйПадеж = ПолучитьСклоненияСтроки(
			НРег(Формат(Выборка.ДатаВыплаты, "ДФ=ММММ")), ,
			"ПД=Предложный")[0];
		ПараметрыДокумента.Вставить("НаименованиеПрограммы", Выборка.НаименованиеПрограммы);
		ПараметрыДокумента.Вставить("ШифрПроекта", Выборка.ШифрПроекта);
		ПараметрыДокумента.Вставить("Приказ", Выборка.Приказ);
		ПараметрыДокумента.Вставить("ДатаВыплаты", МесяцВыплатыПредложныйПадеж + " " + ГодВыплаты); 
		ПараметрыДокумента.Вставить(
			"ИмяФайла",
			Выборка.Код
			+ " "
			+ Выборка.НаименованиеПрограммыСокращенно
			+ " СЗ стимулирование рук за "
			+ МесяцВыплаты);
		ПараметрыДокумента.Вставить("Дата", НачалоМесяца(Выборка.ДатаВыплаты));
	КонецЦикла;
		
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
			
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПРЕДСТАВЛЕНИЕ(Сотрудники.Должность) КАК ДолжностьРуководителя,
	|	СТРОКА(Сотрудники.Наименование) КАК РуководительНаименование,
	|	РасчетСРуководителем.КоличествоСтудентов КАК КоличествоСтудентов,
	|	РасчетСРуководителем.КВыплатеРуководителю КАК КВыплатеРуководителю,
	|	ПРЕДСТАВЛЕНИЕ(РасчетСРуководителем.Месяц) КАК Месяц,
	|	РасчетСРуководителем.Согласовано1Должность КАК Согласовано1Должность,
	|	СТРОКА(СотрудникиСогласован1.Наименование) КАК Согласовано1Наименование,
	|	РасчетСРуководителем.Согласовано2Должность КАК Согласовано2Должность,
	|	СТРОКА(СотрудникиСогласован2.Наименование) КАК Согласовано2Наименование,
	|	РасчетСРуководителем.Согласовано3Должность КАК Согласовано3Должность,
	|	СТРОКА(СотрудникиСогласован3.Наименование) КАК Согласовано3Наименование,
	|	СТРОКА(СтруктурныеПодразделения.Наименование) КАК КафедраРуководителя
	|ИЗ
	|	Документ.РасчетСРуководителем КАК РасчетСРуководителем
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК Сотрудники
	|		ПО РасчетСРуководителем.Руководитель = Сотрудники.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтруктурныеПодразделения КАК СтруктурныеПодразделения
	|		ПО (Сотрудники.Подразделение = СтруктурныеПодразделения.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК СотрудникиСогласован1
	|		ПО РасчетСРуководителем.Согласовано1 = СотрудникиСогласован1.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК СотрудникиСогласован2
	|		ПО РасчетСРуководителем.Согласовано2 = СотрудникиСогласован2.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК СотрудникиСогласован3
	|		ПО РасчетСРуководителем.Согласовано3 = СотрудникиСогласован3.Ссылка
	|ГДЕ
	|	РасчетСРуководителем.Ссылка = &Ссылка";

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		
		ДолжностьРуководителяПрограммы = ПолучитьСклоненияСтроки(НРег(Выборка.ДолжностьРуководителя), , "ПД=Дательный")[0];
		ФИОРуководителяПрограммы = ПолучитьСклоненияСтроки(Выборка.РуководительНаименование, , "ПД=Дательный")[0];
		КафедраРуководителяПрограммы = ПолучитьСклоненияСтроки(Выборка.КафедраРуководителя, , "ПД=Родительный")[0];
		МесяцГода = ПолучитьСклоненияСтроки(НРег(Выборка.Месяц), , "ПД=Предложный")[0];
		МесяцЗаВыплату = МесяцГода + " " + ГодВыплаты; 
		
		ФормСтрока = "Л=ru_RU; ДП=Ложь";
		ПарПредмета = "рубль,рубля,рублей,м,копейка,копейки,копеек,ж,2";
		ПрописьЧисла = ЧислоПрописью(Выборка.КВыплатеРуководителю, ФормСтрока, ПарПредмета);
		КВыплатеСтрока = Строка(Выборка.КВыплатеРуководителю) + " (" + НРег(ПрописьЧисла) + ")";
		
		ПараметрыДокумента.Вставить("Сотрудник", ФИОРуководителяПрограммы);
		ПараметрыДокумента.Вставить("Должность", ДолжностьРуководителяПрограммы);
		ПараметрыДокумента.Вставить("Кафедра", КафедраРуководителяПрограммы);
		ПараметрыДокумента.Вставить("Выплата", КВыплатеСтрока);
		ПараметрыДокумента.Вставить("Месяц", МесяцЗаВыплату);
		ПараметрыДокумента.Вставить("КоличествоСтудентов", Выборка.КоличествоСтудентов);
		ПараметрыДокумента.Вставить("Согласовано1", ИнициалыИФамилияИзСтроки(Выборка.Согласовано1Наименование));
		ПараметрыДокумента.Вставить("Согласовано1Должность", Выборка.Согласовано1Должность);
		ПараметрыДокумента.Вставить("Согласовано2", ИнициалыИФамилияИзСтроки(Выборка.Согласовано2Наименование));
		ПараметрыДокумента.Вставить("Согласовано2Должность", Выборка.Согласовано2Должность);
		ПараметрыДокумента.Вставить("Согласовано3", ИнициалыИФамилияИзСтроки(Выборка.Согласовано3Наименование));
		ПараметрыДокумента.Вставить("Согласовано3Должность", Выборка.Согласовано3Должность);
	КонецЦикла;
	
	ПараметрыДокумента.Вставить("Тип", 
	ПредопределенноеЗначение("Перечисление.ТипыДокументов.СЗСтимулированиеРуководитель"));

	Возврат ПараметрыДокумента;

КонецФункции

&НаСервере
Функция РазбитьФИО(ПолноеФИО)
	Результат = Новый Структура("Фамилия,Имя,Отчество", "", "", "");
	
	Если ПустаяСтрока(ПолноеФИО) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Части = СтрРазделить(СокрЛП(ПолноеФИО), " ", Ложь);
	
	Если Части.Количество() > 0 Тогда
		Результат.Фамилия = Части[0];
	КонецЕсли;
	Если Части.Количество() > 1 Тогда
		Результат.Имя = Части[1];
	КонецЕсли;
	Если Части.Количество() > 2 Тогда
		Результат.Отчество = Части[2];
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

&НаСервере
Функция ИнициалыИФамилияИзСтроки(ПолноеФИО)
	ФИО = РазбитьФИО(ПолноеФИО);
	
	Результат = "";
	Если Не ПустаяСтрока(ФИО.Имя) Тогда
		Результат = Лев(ФИО.Имя, 1) + ".";
		Если Не ПустаяСтрока(ФИО.Отчество) Тогда
			Результат = Результат + Лев(ФИО.Отчество, 1) + ".";
		КонецЕсли;
	КонецЕсли;
	Возврат СокрЛП(Результат + " " + ФИО.Фамилия);
КонецФункции


#КонецОбласти
