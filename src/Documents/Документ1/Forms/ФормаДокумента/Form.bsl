

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	НастроитьПланировщик();
КонецПроцедуры

&НаКлиенте
Процедура НастроитьПланировщик()
	ТекущаяДата = ТекущаяДатаСеанса();
	НачалоМесяца = НачалоМесяца(ТекущаяДата);
	КонецМесяца = КонецМесяца(ТекущаяДата);
	
	Реквизит1.НачалоПериодаОтображения = НачалоМесяца;
	Реквизит1.КонецПериодаОтображения = КонецМесяца;
	Реквизит1.ЕдиницаПериодическогоВарианта = ТипЕдиницыШкалыВремени.Месяц;
	Реквизит1.КратностьПериодическогоВарианта = 1;
	
	НастроитьИнтервалыФона(НачалоМесяца, КонецМесяца);
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьИнтервалыФона(НачалоМесяца, КонецМесяца)
	Реквизит1.ИнтервалыФона.Очистить();
	
	День = НачалоМесяца;
	Пока День <= КонецМесяца Цикл
		ТекущийДень = День;
		
		ДобавитьИнтервал(ТекущийДень, "08:30", "10:00", Истина);
		ДобавитьИнтервал(ТекущийДень, "10:00", "10:10", Ложь);
		ДобавитьИнтервал(ТекущийДень, "10:10", "11:40", Истина);
		ДобавитьИнтервал(ТекущийДень, "11:40", "11:50", Ложь);
		ДобавитьИнтервал(ТекущийДень, "11:50", "13:20", Истина);
		ДобавитьИнтервал(ТекущийДень, "13:20", "14:00", Ложь);
		ДобавитьИнтервал(ТекущийДень, "14:00", "15:30", Истина);
		ДобавитьИнтервал(ТекущийДень, "15:30", "15:40", Ложь);
		ДобавитьИнтервал(ТекущийДень, "15:40", "17:10", Истина);
		ДобавитьИнтервал(ТекущийДень, "17:10", "17:20", Ложь);
		ДобавитьИнтервал(ТекущийДень, "17:20", "18:50", Истина);
		ДобавитьИнтервал(ТекущийДень, "18:50", "19:00", Ложь);
		ДобавитьИнтервал(ТекущийДень, "19:00", "20:30", Истина);
		ДобавитьИнтервал(ТекущийДень, "20:30", "20:40", Ложь);
		ДобавитьИнтервал(ТекущийДень, "20:40", "22:10", Истина);
		
		День = День + 86400;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьИнтервал(Дата, ВремяНачала, ВремяКонца, РабочийИнтервал)
	ЧасыНач = Число(Лев(ВремяНачала, 2));
	МинутыНач = Число(Прав(ВремяНачала, 2));
	ЧасыКон = Число(Лев(ВремяКонца, 2));
	МинутыКон = Число(Прав(ВремяКонца, 2));
	
	НачалоИнтервала = Дата(Год(Дата), Месяц(Дата), День(Дата), ЧасыНач, МинутыНач, 0);
	КонецИнтервала = Дата(Год(Дата), Месяц(Дата), День(Дата), ЧасыКон, МинутыКон, 0);
	
	Реквизит1.ИнтервалыФона.Добавить(НачалоИнтервала, КонецИнтервала);
	
КонецПроцедуры
